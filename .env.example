# Copy to .env and fill in. .env is git-ignored; never commit real values (NFR12).

# PostgreSQL. With Docker Compose the server reaches the database at host "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cohendrix
POSTGRES_USER=cohendrix
POSTGRES_PASSWORD=change-me

# Gemini key for LiteLLM (S1-05, S1-14). Leave empty until you have one.
GEMINI_API_KEY=
