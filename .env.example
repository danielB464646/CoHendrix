# Copy to .env and fill in. .env is git-ignored; never commit real values (NFR12).

# PostgreSQL. With Docker Compose the server reaches the database at host "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cohendrix
POSTGRES_USER=cohendrix
POSTGRES_PASSWORD=change-me

# LLM gateway (S1-05). "mock" plays recorded replies and costs nothing; "litellm" calls
# the real model and spends the shared budget, so switch only on purpose (ADR 0015).
LLM_PROVIDER=mock
LLM_MODEL=gemini/gemini-2.5-flash
LLM_TIMEOUT_S=20
# Folder of recorded replies for the mock (*.json, played in file-name order).
LLM_MOCK_REPLIES_DIR=

# Gemini key, used only when LLM_PROVIDER=litellm. Leave empty until you have one.
GEMINI_API_KEY=
